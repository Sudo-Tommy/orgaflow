{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "node -e \"const fs = require('fs'); const path = require('path'); const src = path.resolve('pb_public'); const dst = path.resolve('../backend/pb_public'); if (fs.existsSync(src)) { const appDst = path.join(dst, '_app'); if (fs.existsSync(appDst)) fs.rmSync(appDst, { recursive: true, force: true }); fs.cpSync(src, dst, { recursive: true }); }\"",
		"build:mobile": "vite build && npx cap sync",
		"cap:sync": "npx cap sync",
		"cap:android": "npx cap open android",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "tsx tests/runner.ts",
		"test:e2e": "tsx tests/runner.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@types/pdfkit": "^0.17.6",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.4",
		"tsx": "^4.23.15",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vite-plugin-node-polyfills": "^0.26.0"
	},
	"dependencies": {
		"@capacitor/android": "^7.6.10",
		"@capacitor/app": "^7.1.2",
		"@capacitor/camera": "^7.0.5",
		"@capacitor/cli": "^7.6.10",
		"@capacitor/core": "^7.6.10",
		"@capacitor/geolocation": "^7.1.8",
		"@capacitor/network": "^7.0.4",
		"@capacitor/preferences": "^7.0.4",
		"@capacitor/push-notifications": "^7.0.7",
		"@capacitor/screen-orientation": "^7.0.4",
		"@capacitor/splash-screen": "^7.0.5",
		"@capacitor/status-bar": "^7.0.6",
		"@google/genai": "^2.21.0",
		"@types/qrcode": "^1.5.6",
		"blob-stream": "^0.1.3",
		"dexie": "^4.4.6",
		"html2canvas-pro": "^2.4.3",
		"lucide-svelte": "^1.0.1",
		"pdf-lib": "^1.17.1",
		"pdfkit": "^0.18.0",
		"pdfkit-table": "^0.2.11",
		"pocketbase": "^0.26.8",
		"qrcode": "^1.5.4"
	}
}
